<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <package android:name="com.google.android.apps.nexuslauncher" />
    </queries>

    <!--
        The module has no screen of its own. Every tweak is in the launcher's
        own Home settings, beside the launcher that reads it, so an activity
        here would open on nothing to change. What remains is the part Home
        settings cannot host: the two providers below, which run in this
        application because this is the process that holds root.
    -->
    <application
        android:allowBackup="false"
        android:description="@string/module_description"
        android:hasCode="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true">

        <!--
            Exported so the launcher can ask which Modes are on. It checks the
            caller itself rather than relying on a permission, because no
            permission exists that this module and the launcher could both hold.
        -->
        <provider
            android:name=".focus.FocusProvider"
            android:authorities="${applicationId}.focus"
            android:exported="true" />

        <!-- Double tap is recognised by the launcher; this root-backed endpoint locks it. -->
        <provider
            android:name=".lock.ScreenLockProvider"
            android:authorities="${applicationId}.screenlock"
            android:exported="true" />
    </application>

</manifest>
