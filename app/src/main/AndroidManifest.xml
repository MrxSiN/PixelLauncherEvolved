<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <package android:name="com.google.android.apps.nexuslauncher" />
    </queries>

    <application
        android:name=".PixelLauncherEvolvedApp"
        android:allowBackup="false"
        android:description="@string/module_description"
        android:hasCode="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.PixelLauncherEvolved">

        <!--
            No launcher category, so this does not appear in the app drawer.
            Every setting is in the launcher's own Home settings, so an icon here
            would open a screen with nothing to change. The activity itself stays,
            exported and addressable by name, for a framework or a person that
            wants to ask whether the module was accepted.
        -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.PixelLauncherEvolved">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>

        <!--
            Exported so the launcher can ask which Modes are on. It checks the
            caller itself rather than relying on a permission, because no
            permission exists that this module and the launcher could both hold.
        -->
        <provider
            android:name=".focus.FocusProvider"
            android:authorities="${applicationId}.focus"
            android:exported="true" />

        <!-- Double tap is recognised by the launcher; this root-backed endpoint locks it. -->
        <provider
            android:name=".lock.ScreenLockProvider"
            android:authorities="${applicationId}.screenlock"
            android:exported="true" />
    </application>

</manifest>
