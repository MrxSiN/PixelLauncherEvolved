<!--
  A launcher badge with its top-right cell burst into a spark: the home screen,
  plus the thing this module adds to it.

  The circular badge under a long 45-degree shadow is the Pixel Launcher's own
  idiom, so the icon sits next to it on a home screen without pretending to be
  it. The mark inside is this project's, not Google's.

  Drawn on the adaptive icon's 108dp canvas. The badge sits up and left of
  centre so the shadow has somewhere to fall; the shadow runs off the edge on
  purpose and is trimmed by whatever mask the device applies.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Long shadow, cast down-right from the badge. -->
    <path
        android:fillColor="#000000"
        android:fillAlpha="0.2"
        android:pathData="M29.7,62.3 L75.7,108.3 L108.3,75.7 L62.3,29.7 Z" />

    <!-- The badge. -->
    <path
        android:fillColor="#FFF6F4FF"
        android:pathData="M46,46m-23,0a23,23 0 1,0 46,0a23,23 0 1,0 -46,0" />

    <!-- Three cells of a launcher grid. -->
    <path
        android:fillColor="#FF3A21C4"
        android:pathData="M37,37m-5.5,0a5.5,5.5 0 1,0 11,0a5.5,5.5 0 1,0 -11,0" />
    <path
        android:fillColor="#FF3A21C4"
        android:pathData="M37,55m-5.5,0a5.5,5.5 0 1,0 11,0a5.5,5.5 0 1,0 -11,0" />
    <path
        android:fillColor="#FF3A21C4"
        android:pathData="M55,55m-5.5,0a5.5,5.5 0 1,0 11,0a5.5,5.5 0 1,0 -11,0" />

    <!-- The fourth, evolved. -->
    <path
        android:fillColor="#FF3A21C4"
        android:pathData="M55,27c0.7,5.9 4.1,9.3 10,10 -5.9,0.7 -9.3,4.1 -10,10 -0.7,-5.9 -4.1,-9.3 -10,-10 5.9,-0.7 9.3,-4.1 10,-10Z" />
</vector>
