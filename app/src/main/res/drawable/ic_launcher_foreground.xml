<!--
  The mark alone, white, on the flat brand circle the adaptive background
  paints. A home screen grid whose top-right cell has burst into a spark: the
  thing this module changes, and what it changes about it.

  Drawn on the adaptive icon's 108dp canvas and kept inside the 66dp safe
  circle, so no mask can clip a point off the spark. The mark is centred rather
  than badged, because the icon is read at one size in an Xposed manager's list
  and a badge inside a mask is a circle inside a circle.

  The same geometry serves the monochrome layer, so the themed icon is this
  drawing and not an approximation of it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Three cells of a launcher grid. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M44,44m-7.5,0a7.5,7.5 0 1,0 15,0a7.5,7.5 0 1,0 -15,0" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M44,64m-7.5,0a7.5,7.5 0 1,0 15,0a7.5,7.5 0 1,0 -15,0" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M64,64m-7.5,0a7.5,7.5 0 1,0 15,0a7.5,7.5 0 1,0 -15,0" />

    <!-- The fourth, evolved. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M64,32.5c0.8,6.8 4.7,10.7 11.5,11.5 -6.8,0.8 -10.7,4.7 -11.5,11.5 -0.8,-6.8 -4.7,-10.7 -11.5,-11.5 6.8,-0.8 10.7,-4.7 11.5,-11.5Z" />
