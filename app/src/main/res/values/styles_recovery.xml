<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Layout recovery draws its own back button and large title, the way Settings does. -->
    <style name="Theme.Recovery" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/recovery_page</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
